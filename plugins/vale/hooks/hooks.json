{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/prose_lint.py\"",
            "timeout": 60,
            "statusMessage": "Checking documentation style"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/prose_lint.py\"",
            "timeout": 60,
            "statusMessage": "Checking documentation style"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/prose_lint.py\"",
            "timeout": 60,
            "statusMessage": "Checking documentation style"
          }
        ]
      }
    ]
  }
}
